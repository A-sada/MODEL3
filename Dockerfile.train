# RL route planner training image (CPU)
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install torch first (CPU wheels) so other deps can detect it if needed
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.3"

# Project Python deps
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Create a user that matches the host UID/GID to avoid root-owned outputs
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} sadahiro \
    && useradd -m -u ${UID} -g ${GID} sadahiro

# Use the requested directory layout inside the container
WORKDIR /home/sadahiro/RL_model/MODEL3

# Copy only MODEL3 to keep the image smaller
COPY MODEL3 /home/sadahiro/RL_model/MODEL3
RUN mkdir -p /home/sadahiro/RL_model/new_output \
    && chown -R sadahiro:sadahiro /home/sadahiro/RL_model

ENV PYTHONPATH=/home/sadahiro/RL_model:/home/sadahiro/RL_model/MODEL3

USER sadahiro

# Default: run RL training script
CMD ["python", "train_rl_route_planner.py"]
